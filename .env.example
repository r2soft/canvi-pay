# API
CANVI_BASE_URL=https://api.canvi.com.br
CANVI_API_KEY=
CANVI_API_SECRET=

# HTTP
CANVI_TIMEOUT=10

# Webhooks
CANVI_WEBHOOK_HEADER=X-Canvi-Signature
CANVI_WEBHOOK_ALGO=sha256
CANVI_WEBHOOK_SECRET=
CANVI_WEBHOOK_PUBLIC_KEY=
CANVI_WEBHOOK_TOLERANCE=300

# Storage (opcional)
CANVI_TOKEN_STORAGE_PATH=/var/run/canvi-pay/tokens
CANVI_TOKEN_STORAGE_ID=default

# App
APP_TZ=America/Sao_Paulo
